// ---- Timing ----
const unsigned long desired_Ts_ms = 10;   // sample time (100 Hz loop)
unsigned long last_time_ms;
unsigned long start_time_ms;
float current_time;                       // seconds since start

// ---- Logging ----
const int LOG_EVERY = 5;                  // print every 5th sample (20 Hz)
int log_counter = 0;

// ---- Pins (index 0 = motor 1, index 1 = motor 2) ----
const int enablePin = 4;
const int dirPin[2] = {7, 8};
const int pwmPin[2] = {9, 10};
const int encA[2]   = {2, 3};
const int encB[2]   = {5, 6};

// ---- Distance to drive ----
const float DISTANCE_FT = 4;           // <-- CHANGE THIS (feet)
const unsigned long START_DELAY_MS = 3000; // wait after power-up so you can unplug/place the robot

// ---- Robot geometry ----
// Two drive wheels, same diameter (rear is a passive ball caster)
const float WHEEL_DIAMETER_IN = 5.9;
const float WHEEL_RADIUS_IN   = WHEEL_DIAMETER_IN / 2.0;

// ---- Encoder ----
const float COUNTS_PER_REV = 800.0;
volatile long encoderCount[2] = {0, 0};
long prevPos_counts[2] = {0, 0};

// ---- Controller gains ----
float Kp = 3;                     // inner velocity loop: volts per (rad/s)
float Kp_pos = 5.0;               // outer position loop: (rad/s) per rad
float Ki_pos = .5;                // outer position loop integral
const float MAX_SPEED = 8.0;      // cap on requested wheel speed [rad/s]
const float Battery_Voltage = 7.6;

// ---- Controller state ----
float integral_error[2] = {0, 0};
float target_rad = 0;             // wheel rotation target (same for both motors)

// ---- Encoder ISRs ----
void encoderISR1() { encoderCount[0] += (digitalRead(encB[0]) == HIGH) ? -1 : 1; }
void encoderISR2() { encoderCount[1] += (digitalRead(encB[1]) == HIGH) ? 1 : -1; }

// ---- Optional: type a new distance in feet over Serial (still works if plugged in) ----
void readDistanceFromSerial() {
  static char buf[16];
  static int idx = 0;

  while (Serial.available() > 0) {
    char c = Serial.read();
    if (c == '\n' || c == '\r') {               // end of message
      if (idx > 0) {
        buf[idx] = '\0';
        float feet = atof(buf);

        // Start a fresh move from the current spot
        noInterrupts();
        encoderCount[0] = 0;
        encoderCount[1] = 0;
        interrupts();
        prevPos_counts[0] = 0;
        prevPos_counts[1] = 0;
        integral_error[0] = 0;
        integral_error[1] = 0;

        target_rad = (feet * 12.0) / WHEEL_RADIUS_IN;

        Serial.print("Moving ");
        Serial.print(feet, 2);
        Serial.println(" ft");
      }
      idx = 0;
    } else if (idx < (int)sizeof(buf) - 1) {
      buf[idx++] = c;
    }
  }
}

void setup() {
  pinMode(enablePin, OUTPUT);
  for (int i = 0; i < 2; i++) {
    pinMode(dirPin[i], OUTPUT);
    pinMode(pwmPin[i], OUTPUT);
    pinMode(encA[i], INPUT);
    pinMode(encB[i], INPUT);
  }
  attachInterrupt(digitalPinToInterrupt(encA[0]), encoderISR1, RISING);
  attachInterrupt(digitalPinToInterrupt(encA[1]), encoderISR2, RISING);

  Serial.begin(115200);

  delay(START_DELAY_MS);                        // time to unplug and set the robot down
  digitalWrite(enablePin, HIGH);                // motor driver on

  // Hardcoded distance: feet -> inches -> wheel radians
  target_rad = (DISTANCE_FT * 12.0) / WHEEL_RADIUS_IN;

  last_time_ms = millis();
  start_time_ms = last_time_ms;
}

void loop() {
  readDistanceFromSerial();                     // optional serial override

  // ---- Run the controller at a fixed 10 ms rate ----
  if (millis() - last_time_ms < desired_Ts_ms) return;
  last_time_ms += desired_Ts_ms;

  float Ts = (float)desired_Ts_ms / 1000.0;
  current_time = (float)(millis() - start_time_ms) / 1000.0;

  float actual_pos[2], actual_speed[2];

  long counts[2];
  noInterrupts();
  counts[0] = encoderCount[0];
  counts[1] = encoderCount[1];
  interrupts();

  for (int i = 0; i < 2; i++) {
    // ---- Measurements ----
    actual_pos[i]   = 2 * PI * (float)counts[i] / COUNTS_PER_REV;
    actual_speed[i] = 2 * PI * (float)(counts[i] - prevPos_counts[i]) / COUNTS_PER_REV / Ts;
    prevPos_counts[i] = counts[i];

    // ---- Outer loop: PI position -> desired speed ----
    float pos_error = target_rad - actual_pos[i];
    integral_error[i] += pos_error * Ts;
    float desired_speed = Kp_pos * pos_error + Ki_pos * integral_error[i];

    if (desired_speed > MAX_SPEED || desired_speed < -MAX_SPEED) {
      integral_error[i] -= pos_error * Ts;      // anti-windup
      desired_speed = constrain(desired_speed, -MAX_SPEED, MAX_SPEED);
    }

    // ---- Inner loop: P velocity -> voltage ----
    float error = desired_speed - actual_speed[i];
    float Voltage = Kp * error;

    // ---- Output ----
    if (i == 0) {
      // Motor 0 stays normal
      digitalWrite(dirPin[i], (Voltage > 0) ? LOW : HIGH);
    } else {
      // Motor 1 is physically reversed
      digitalWrite(dirPin[i], (Voltage > 0) ? HIGH : LOW);
    }
    unsigned int PWM = 255 * fabs(Voltage) / Battery_Voltage;
    analogWrite(pwmPin[i], min(PWM, 255));
  }

  // ---- Logging: distance traveled (average of both wheels) in feet ----
  if (++log_counter >= LOG_EVERY) {
    log_counter = 0;
    float avg_rad = (actual_pos[0] + actual_pos[1]) / 2.0;
    float feet_traveled = avg_rad * WHEEL_RADIUS_IN / 12.0;
    Serial.print("Traveled: ");
    Serial.print(feet_traveled, 2);
    Serial.println(" ft");
  }
}
