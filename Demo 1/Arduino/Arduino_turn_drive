const float DESIRED_ANGLE_DEG   = -90.0;    // degrees, + = counterclockwise (turn left), 0 = no turn
const float DESIRED_DISTANCE_FT = 4.0;     // feet (1 to 10)

// ---- Robot geometry ----
const float WHEEL_DIAMETER_IN = 5.9;
const float WHEEL_RADIUS_IN   = WHEEL_DIAMETER_IN / 2.0;
// !!! MEASURE THIS: distance between the centers of the two wheels' contact patches (inches).
// 11.0 is a PLACEHOLDER. Rotation accuracy depends heavily on this number.
const float WHEELBASE_IN      = 16;

const int ROTATE_SIGN = 1;

const unsigned long START_DELAY_MS = 3000; // wait after power-up so you can set the robot down (must be < 10 s)

// ---- Timing ----
const unsigned long desired_Ts_ms = 10;    // sample time (100 Hz loop)
unsigned long last_time_ms;
unsigned long start_time_ms;
float current_time;

// ---- Logging ----
const int LOG_EVERY = 5;                   // print every 5th sample (20 Hz)
int log_counter = 0;

// ---- Pins (index 0 = motor 1, index 1 = motor 2) ----
const int enablePin = 4;
const int dirPin[2] = {7, 8};
const int pwmPin[2] = {9, 10};
const int encA[2]   = {2, 3};
const int encB[2]   = {5, 6};

// ---- Encoder ----
const float COUNTS_PER_REV = 800;
volatile long encoderCount[2] = {0, 0};
long prevPos_counts[2] = {0, 0};

// ---- Controller gains ----
float Kp = 3;                     // inner velocity loop: volts per (rad/s)
float Kp_pos = 5.0;               // outer position loop: (rad/s) per rad
float Ki_pos = 0.5;               // outer position loop integral
const float MAX_SPEED = 8.0;      // cap on requested wheel speed [rad/s]
const float Battery_Voltage = 7.6;

// ---- Controller state ----
float integral_error[2] = {0, 0};
float target_rad[2] = {0, 0};     // per-wheel rotation target [rad] (differs during the turn)

// ---- Phase handling ----
// 0 = rotating in place, 1 = driving straight, 2 = done
int phase = 0;
const float SETTLE_POS_TOL = 0.03;   // rad of wheel rotation (~0.09 in at the wheel)
const float SETTLE_VEL_TOL = 0.2;    // rad/s
const int   SETTLE_SAMPLES = 30;     // must stay settled for 30 samples (0.3 s)
int settleCount = 0;

// ---- Encoder ISRs ----
void encoderISR1() { encoderCount[0] += (digitalRead(encB[0]) == HIGH) ? -1 : 1; }
void encoderISR2() { encoderCount[1] += (digitalRead(encB[1]) == HIGH) ? 1 : -1; }

// Zero encoders and controller memory so the next phase starts fresh
void resetForNewMove() {
  noInterrupts();
  encoderCount[0] = 0;
  encoderCount[1] = 0;
  interrupts();
  prevPos_counts[0] = 0;
  prevPos_counts[1] = 0;
  integral_error[0] = 0;
  integral_error[1] = 0;
  settleCount = 0;
}

void setup() {
  pinMode(enablePin, OUTPUT);
  for (int i = 0; i < 2; i++) {
    pinMode(dirPin[i], OUTPUT);
    pinMode(pwmPin[i], OUTPUT);
    pinMode(encA[i], INPUT);
    pinMode(encB[i], INPUT);
  }
  attachInterrupt(digitalPinToInterrupt(encA[0]), encoderISR1, RISING);
  attachInterrupt(digitalPinToInterrupt(encA[1]), encoderISR2, RISING);

  Serial.begin(115200);

  delay(START_DELAY_MS);                     // time to set the robot down
  digitalWrite(enablePin, HIGH);             // motor driver on

  // ---- Phase 0 targets: spin in place ----
  // Convert degrees to radians, then each wheel travels an arc of (theta * wheelbase / 2).
  // Wheels go in opposite directions.
  float angle_rad     = DESIRED_ANGLE_DEG * PI / 180.0;
  float wheel_arc_in  = angle_rad * (WHEELBASE_IN / 2.0);
  float wheel_rad     = wheel_arc_in / WHEEL_RADIUS_IN;
  target_rad[0] = -ROTATE_SIGN * wheel_rad;  // left wheel backward for CCW
  target_rad[1] =  ROTATE_SIGN * wheel_rad;  // right wheel forward for CCW

  last_time_ms = millis();
  start_time_ms = last_time_ms;
}

void loop() {
  // ---- Run the controller at a fixed 10 ms rate ----
  if (millis() - last_time_ms < desired_Ts_ms) return;
  last_time_ms += desired_Ts_ms;

  float Ts = (float)desired_Ts_ms / 1000.0;
  current_time = (float)(millis() - start_time_ms) / 1000.0;

  float actual_pos[2], actual_speed[2], pos_err_now[2];

  long counts[2];
  noInterrupts();
  counts[0] = encoderCount[0];
  counts[1] = encoderCount[1];
  interrupts();

  for (int i = 0; i < 2; i++) {
    // ---- Measurements ----
    actual_pos[i]   = 2 * PI * (float)counts[i] / COUNTS_PER_REV;
    actual_speed[i] = 2 * PI * (float)(counts[i] - prevPos_counts[i]) / COUNTS_PER_REV / Ts;
    prevPos_counts[i] = counts[i];

    // ---- Outer loop: PI position -> desired speed ----
    float pos_error = target_rad[i] - actual_pos[i];
    pos_err_now[i] = pos_error;
    integral_error[i] += pos_error * Ts;
    float desired_speed = Kp_pos * pos_error + Ki_pos * integral_error[i];

    if (desired_speed > MAX_SPEED || desired_speed < -MAX_SPEED) {
      integral_error[i] -= pos_error * Ts;   // anti-windup
      desired_speed = constrain(desired_speed, -MAX_SPEED, MAX_SPEED);
    }

    // ---- Inner loop: P velocity -> voltage ----
    float error = desired_speed - actual_speed[i];
    float Voltage = Kp * error;

    // ---- Output ----
    if (i == 0) {
      digitalWrite(dirPin[i], (Voltage > 0) ? LOW : HIGH);    // Motor 0 normal
    } else {
      digitalWrite(dirPin[i], (Voltage > 0) ? HIGH : LOW);    // Motor 1 physically reversed
    }
    unsigned int PWM = 255 * fabs(Voltage) / Battery_Voltage;
    analogWrite(pwmPin[i], min(PWM, 255));
  }

  // ---- Phase transitions ----
  bool settled = true;
  for (int i = 0; i < 2; i++) {
    if (fabs(pos_err_now[i]) > SETTLE_POS_TOL || fabs(actual_speed[i]) > SETTLE_VEL_TOL) settled = false;
  }
  settleCount = settled ? settleCount + 1 : 0;

  if (phase == 0 && settleCount >= SETTLE_SAMPLES) {
    // Turn finished -> set up the straight drive
    resetForNewMove();
    float drive_rad = (DESIRED_DISTANCE_FT * 12.0) / WHEEL_RADIUS_IN;
    target_rad[0] = drive_rad;
    target_rad[1] = drive_rad;
    phase = 1;
    Serial.println("Turn done, driving forward");
  } else if (phase == 1 && settleCount >= SETTLE_SAMPLES) {
    phase = 2;                               // controller keeps holding position
    Serial.println("Done");
  }

  // ---- Logging ----
  if (++log_counter >= LOG_EVERY) {
    log_counter = 0;
    if (phase == 0) {
      // Heading estimate in degrees from wheel difference (CCW positive)
      float heading_rad = ROTATE_SIGN * WHEEL_RADIUS_IN * (actual_pos[1] - actual_pos[0]) / WHEELBASE_IN;
      float heading_deg = heading_rad * 180.0 / PI;
      Serial.print("Phase 0, heading (deg): ");
      Serial.println(heading_deg, 2);
    } else {
      float avg_rad = (actual_pos[0] + actual_pos[1]) / 2.0;
      float feet_traveled = avg_rad * WHEEL_RADIUS_IN / 12.0;
      Serial.print("Phase ");
      Serial.print(phase);
      Serial.print(", traveled: ");
      Serial.print(feet_traveled, 2);
      Serial.println(" ft");
    }
  }
}
