// ============================================================
// Demo 2, Trial 1: spin in place (SEARCH) until 'F' is received,
// then drive forward a hardcoded distance (DRIVE) and hold (DONE).
//
// Send 'F' over serial (Serial Monitor now, Raspberry Pi later).
// Press reset or cycle power to run again.
// ============================================================

// ---- Modes ----
enum Mode { SEARCH, DRIVE, DONE };
Mode mode = SEARCH;
bool startDrive = false;                  // set by serial 'F', handled in the control loop

// ---- Settings you will tune ----
const float SEARCH_SPEED = 2.0;           // wheel speed while spinning [rad/s]
const float DRIVE_DISTANCE_FT = 3.0;      // hardcoded forward distance [ft]
const float POS_DEADBAND_RAD = 0.05;      // stop commanding motion when this close to target

// ---- Robot geometry ----
const float WHEEL_DIAMETER_IN = 5.9;
const float WHEEL_RADIUS_IN = WHEEL_DIAMETER_IN / 2.0;

// ---- Timing ----
const unsigned long desired_Ts_ms = 10;   // sample time (100 Hz loop)
unsigned long last_time_ms;
unsigned long start_time_ms;
float current_time;                       // seconds since start

// ---- Logging (printing at 100 Hz makes the Serial Monitor hard to use) ----
const int LOG_EVERY = 5;                  // print every 5th sample (20 Hz)
int log_counter = 0;

// ---- Pins (index 0 = motor 1, index 1 = motor 2) ----
const int enablePin = 4;
const int dirPin[2] = {7, 8};
const int pwmPin[2] = {9, 10};
const int encA[2]   = {2, 3};
const int encB[2]   = {5, 6};

// ---- Encoder ----
const float COUNTS_PER_REV = 800.0;
volatile long encoderCount[2] = {0, 0};
long prevPos_counts[2] = {0, 0};
long driveStart_counts[2] = {0, 0};       // encoder counts when the drive began

// ---- Controller gains ----
float Kp = 3;                     // inner velocity loop: volts per (rad/s)
float Kp_pos = 5.0;               // outer position loop: (rad/s) per rad
float Ki_pos = 0.5;               // outer position loop integral
const float MAX_SPEED = 8.0;      // cap on requested wheel speed [rad/s]
const float Battery_Voltage = 7.6;

// ---- Controller state ----
float integral_error[2] = {0, 0};

// ---- Encoder ISRs ----
void encoderISR1() { encoderCount[0] += (digitalRead(encB[0]) == HIGH) ? 1 : -1; }
void encoderISR2() { encoderCount[1] += (digitalRead(encB[1]) == HIGH) ? -1 : 1; }

// ---- Check serial for commands (non-blocking) ----
// 'F' = marker found -> stop searching and start driving
void readSerialCommand() {
  while (Serial.available() > 0) {
    char c = Serial.read();
    if (c == 'F' && mode == SEARCH) {
      startDrive = true;
    }
  }
}

void setup() {
  pinMode(enablePin, OUTPUT);
  for (int i = 0; i < 2; i++) {
    pinMode(dirPin[i], OUTPUT);
    pinMode(pwmPin[i], OUTPUT);
    pinMode(encA[i], INPUT);
    pinMode(encB[i], INPUT);
  }
  attachInterrupt(digitalPinToInterrupt(encA[0]), encoderISR1, RISING);
  attachInterrupt(digitalPinToInterrupt(encA[1]), encoderISR2, RISING);
  digitalWrite(enablePin, HIGH);                // motor driver on

  Serial.begin(115200);
  last_time_ms = millis();
  start_time_ms = last_time_ms;
}

void loop() {
  readSerialCommand();                          // check for commands every pass

  // ---- Run the controller at a fixed 10 ms rate ----
  if (millis() - last_time_ms < desired_Ts_ms) return;
  last_time_ms += desired_Ts_ms;

  float Ts = (float)desired_Ts_ms / 1000.0;
  current_time = (float)(millis() - start_time_ms) / 1000.0;

  long counts[2];
  noInterrupts();
  counts[0] = encoderCount[0];
  counts[1] = encoderCount[1];
  interrupts();

  // ---- Handle the SEARCH -> DRIVE transition ----
  // Use the current counts as "zero" so the drive distance is measured
  // from wherever the robot stopped spinning.
  if (startDrive) {
    startDrive = false;
    driveStart_counts[0] = counts[0];
    driveStart_counts[1] = counts[1];
    integral_error[0] = 0;
    integral_error[1] = 0;
    mode = DRIVE;
  }

  // Target wheel rotation for the hardcoded distance [rad]
  float target_rad = (DRIVE_DISTANCE_FT * 12.0) / WHEEL_RADIUS_IN;

  for (int i = 0; i < 2; i++) {
    // ---- Measurements ----
    float actual_speed = 2 * PI * (float)(counts[i] - prevPos_counts[i]) / COUNTS_PER_REV / Ts;
    prevPos_counts[i] = counts[i];

    // ---- Speed command depends on the mode ----
    float desired_speed = 0;

    if (mode == SEARCH) {
      // Spin in place: wheels turn in opposite directions.
      // If the robot spins the wrong way, swap the signs.
      desired_speed = (i == 0) ? -SEARCH_SPEED : SEARCH_SPEED;

    } else if (mode == DRIVE) {
      // Wheel position measured since the drive began [rad]
      float actual_pos = 2 * PI * (float)(counts[i] - driveStart_counts[i]) / COUNTS_PER_REV;

      // Outer loop: PI position -> desired speed
      float pos_error = target_rad - actual_pos;

      if (fabs(pos_error) < POS_DEADBAND_RAD) {
        desired_speed = 0;                      // close enough, stop twitching
        integral_error[i] = 0;
      } else {
        integral_error[i] += pos_error * Ts;
        desired_speed = Kp_pos * pos_error + Ki_pos * integral_error[i];

        if (desired_speed > MAX_SPEED || desired_speed < -MAX_SPEED) {
          integral_error[i] -= pos_error * Ts;  // anti-windup
        }
      }

    } else {
      // DONE: hold still
      desired_speed = 0;
    }

    desired_speed = constrain(desired_speed, -MAX_SPEED, MAX_SPEED);

    // ---- Inner loop: P velocity -> voltage ----
    float error = desired_speed - actual_speed;
    float Voltage = Kp * error;

    // ---- Output ----
    if (i == 0) {
      // Motor 0 stays normal
      digitalWrite(dirPin[i], (Voltage > 0) ? HIGH : LOW);
    } else {
      // Motor 1 is physically reversed
      digitalWrite(dirPin[i], (Voltage > 0) ? LOW : HIGH);
    }
    unsigned int PWM = 255 * fabs(Voltage) / Battery_Voltage;
    analogWrite(pwmPin[i], min(PWM, 255));
  }

  // ---- Logging at 20 Hz ----
  log_counter++;
  if (log_counter >= LOG_EVERY) {
    log_counter = 0;
    Serial.print(current_time);
    Serial.print("\t");
    if (mode == SEARCH) Serial.println("SEARCH");
    else if (mode == DRIVE) Serial.println("DRIVE");
    else Serial.println("DONE");
  }
}
