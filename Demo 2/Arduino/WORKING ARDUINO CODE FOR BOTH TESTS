#include <stdlib.h>

// =====================================================
// DEMO 2 - ARDUINO ROBOT
// =====================================================

enum Mode {
  SEARCH_TURN,
  SEARCH_WAIT,
  ALIGN_TURN,
  DRIVE,
  DONE,
  ARROW_TURN
};

Mode mode = SEARCH_TURN;

// =====================================================
// TEST SELECTION
// =====================================================

const bool ENABLE_ARROW_TURN = true;

// false = Test 1: approach marker and stop
// true  = Test 2: approach marker and turn 90 degrees

char cmd_arrow = 'L';

// =====================================================
// ORIGINAL SEARCH BEHAVIOR
// =====================================================

const float SEARCH_STEP_DEG = 30.0;
const unsigned long SEARCH_PAUSE_MS = 3500;
unsigned long pause_start_ms = 0;

// =====================================================
// ROBOT GEOMETRY
// =====================================================

const float WHEEL_DIAMETER_IN = 5.9;
const float WHEEL_RADIUS_IN = WHEEL_DIAMETER_IN / 2.0;
const float TRACK_WIDTH_IN = 15.0;
const float TURN_SIGN = -1.0;

// =====================================================
// SERIAL MESSAGE LIMITS
// =====================================================

const float MAX_ANGLE_DEG = 25.0;
const float MIN_DIST_IN = 0.0;
const float MAX_DIST_IN = 200.0;
const float STOP_DISTANCE_IN = 8.0;

// =====================================================
// PENDING COMMAND
// =====================================================

bool newCommand = false;
float cmd_angle_deg = 0;
float cmd_distance_in = 0;

// =====================================================
// MOVEMENT TARGETS
// =====================================================

float target_rad[2] = {0, 0};
long moveStart_counts[2] = {0, 0};
float pos_error_now[2] = {0, 0};

// =====================================================
// MOVEMENT COMPLETION
// =====================================================

const float POS_DEADBAND_RAD = 0.05;
const int SETTLE_SAMPLES = 10;
const unsigned long MOVE_TIMEOUT_MS = 24000;

int settle_count = 0;
unsigned long move_start_ms = 0;

// =====================================================
// TIMING
// =====================================================

const unsigned long desired_Ts_ms = 10;
unsigned long last_time_ms;

// =====================================================
// MOTOR AND ENCODER PINS
// =====================================================

const int enablePin = 4;

const int dirPin[2] = {7, 8};
const int pwmPin[2] = {9, 10};

const int encA[2] = {2, 3};
const int encB[2] = {5, 6};

// =====================================================
// ENCODER SETTINGS
// =====================================================

const float COUNTS_PER_REV = 800.0;

volatile long encoderCount[2] = {0, 0};
long prevPos_counts[2] = {0, 0};

// =====================================================
// CONTROLLER GAINS
// =====================================================

float Kp = 2.5;
float Kp_pos = 5.0;
float Ki_pos = 0.5;

const float MAX_SPEED = 3.0;
const float Battery_Voltage = 7.6;

float integral_error[2] = {0, 0};

// =====================================================
// ENCODER INTERRUPTS
// =====================================================

void encoderISR1() {
  encoderCount[0] +=
    (digitalRead(encB[0]) == HIGH) ? 1 : -1;
}

void encoderISR2() {
  encoderCount[1] +=
    (digitalRead(encB[1]) == HIGH) ? -1 : 1;
}

// =====================================================
// TURN ANGLE TO WHEEL RADIANS
// =====================================================

float turnDegToWheelRad(float deg) {

  float arc_in =
    (TRACK_WIDTH_IN / 2.0) *
    (deg * PI / 180.0);

  return arc_in / WHEEL_RADIUS_IN;
}

// =====================================================
// START A MOVEMENT
// =====================================================

void startMove(
  float t0,
  float t1,
  long c0,
  long c1,
  Mode newMode
) {

  target_rad[0] = t0;
  target_rad[1] = t1;

  moveStart_counts[0] = c0;
  moveStart_counts[1] = c1;

  integral_error[0] = 0;
  integral_error[1] = 0;

  settle_count = 0;
  move_start_ms = millis();

  mode = newMode;
}

// =====================================================
// SERIAL READER WITH DEBUGGING
//
// Expected Pi messages:
//
// Test 1:
// 60.00,-12.50
//
// Test 2:
// 60.00,-12.50,L
// 60.00,-12.50,R
//
// Each message must end with \n
// =====================================================

void readSerialCommand() {

  static char buf[40];
  static int idx = 0;

  while (Serial.available() > 0) {

    char c = Serial.read();

    if (c == '\n' || c == '\r') {

      buf[idx] = '\0';

      if (idx > 0) {

        Serial.print("RECEIVED: ");
        Serial.println(buf);

        if (mode == SEARCH_TURN ||
            mode == SEARCH_WAIT) {

          // ---- Parse distance ----

          char *end1;
          float dist = strtod(buf, &end1);

          if (end1 == buf || *end1 != ',') {

            Serial.println("ERROR: DISTANCE FORMAT");

          } else {

            // ---- Parse angle ----

            char *angleStart = end1 + 1;
            char *end2;

            float angle = strtod(angleStart, &end2);

            if (end2 == angleStart) {

              Serial.println("ERROR: ANGLE FORMAT");

            } else {

              // ---- Parse optional arrow ----

              char arrow = '\0';
              bool validFormat = false;

              if (*end2 == '\0') {

                validFormat = !ENABLE_ARROW_TURN;

              } else if (
                *end2 == ',' &&
                (end2[1] == 'L' || end2[1] == 'R') &&
                end2[2] == '\0'
              ) {

                arrow = end2[1];
                validFormat = true;
              }

              // ---- Validate command ----

              if (!validFormat) {

                Serial.println("ERROR: ARROW FORMAT");

              } else if (
                angle < -MAX_ANGLE_DEG ||
                angle > MAX_ANGLE_DEG
              ) {

                Serial.println("ERROR: ANGLE RANGE");

              } else if (
                dist <= MIN_DIST_IN ||
                dist > MAX_DIST_IN
              ) {

                Serial.println("ERROR: DISTANCE RANGE");

              } else {

                // ---- Accept command ----

                cmd_distance_in = dist;
                cmd_angle_deg = angle;

                if (ENABLE_ARROW_TURN) {
                  cmd_arrow = arrow;
                }

                newCommand = true;

                Serial.println("COMMAND ACCEPTED");
              }
            }
          }

        } else {

          Serial.println("ERROR: NOT SEARCHING");
        }
      }

      idx = 0;

    } else if (idx < (int)sizeof(buf) - 1) {

      buf[idx++] = c;

    } else {

      idx = 0;
    }
  }
}

// =====================================================
// SETUP
// =====================================================

void setup() {

  pinMode(enablePin, OUTPUT);

  for (int i = 0; i < 2; i++) {

    pinMode(dirPin[i], OUTPUT);
    pinMode(pwmPin[i], OUTPUT);

    pinMode(encA[i], INPUT);
    pinMode(encB[i], INPUT);
  }

  attachInterrupt(
    digitalPinToInterrupt(encA[0]),
    encoderISR1,
    RISING
  );

  attachInterrupt(
    digitalPinToInterrupt(encA[1]),
    encoderISR2,
    RISING
  );

  digitalWrite(enablePin, HIGH);

  Serial.begin(115200);
  delay(100);
  Serial.println("ARDUINO READY");

  last_time_ms = millis();

  // Original 30-degree search
  float w = turnDegToWheelRad(SEARCH_STEP_DEG);

  startMove(
    -TURN_SIGN * w,
     TURN_SIGN * w,
    0,
    0,
    SEARCH_TURN
  );
}

// =====================================================
// MAIN LOOP
// =====================================================

void loop() {

  readSerialCommand();

  if (millis() - last_time_ms < desired_Ts_ms) {
    return;
  }

  last_time_ms += desired_Ts_ms;

  float Ts =
    (float)desired_Ts_ms / 1000.0;

  long counts[2];

  noInterrupts();

  counts[0] = encoderCount[0];
  counts[1] = encoderCount[1];

  interrupts();

  // =================================================
  // NEW COMMAND: ALIGN WITH MARKER
  // =================================================

  if (newCommand) {

    newCommand = false;

    float w =
      turnDegToWheelRad(fabs(cmd_angle_deg));

    float dir =
      (cmd_angle_deg >= 0) ? 1.0 : -1.0;

    startMove(
      -TURN_SIGN * dir * w,
       TURN_SIGN * dir * w,
      counts[0],
      counts[1],
      ALIGN_TURN
    );
  }

  // =================================================
  // ORIGINAL SEARCH BEHAVIOR
  // =================================================

  if (
    mode == SEARCH_WAIT &&
    millis() - pause_start_ms >= SEARCH_PAUSE_MS
  ) {

    float w =
      turnDegToWheelRad(SEARCH_STEP_DEG);

    startMove(
      -TURN_SIGN * w,
       TURN_SIGN * w,
      counts[0],
      counts[1],
      SEARCH_TURN
    );
  }

  // =================================================
  // MOTOR CONTROL
  // =================================================

  for (int i = 0; i < 2; i++) {

    float actual_speed =
      2 * PI *
      (float)(counts[i] - prevPos_counts[i]) /
      COUNTS_PER_REV / Ts;

    prevPos_counts[i] = counts[i];

    float desired_speed = 0;

    bool moving = (
      mode == SEARCH_TURN ||
      mode == ALIGN_TURN ||
      mode == DRIVE ||
      mode == ARROW_TURN
    );

    if (moving) {

      float actual_pos =
        2 * PI *
        (float)(counts[i] - moveStart_counts[i]) /
        COUNTS_PER_REV;

      float pos_error =
        target_rad[i] - actual_pos;

      pos_error_now[i] = pos_error;

      if (fabs(pos_error) < POS_DEADBAND_RAD) {

        desired_speed = 0;
        integral_error[i] = 0;

      } else {

        integral_error[i] += pos_error * Ts;

        desired_speed =
          Kp_pos * pos_error +
          Ki_pos * integral_error[i];

        if (
          desired_speed > MAX_SPEED ||
          desired_speed < -MAX_SPEED
        ) {

          integral_error[i] -= pos_error * Ts;
        }
      }
    }

    desired_speed = constrain(
      desired_speed,
      -MAX_SPEED,
      MAX_SPEED
    );

    // ---- Velocity controller ----

    float error =
      desired_speed - actual_speed;

    float Voltage =
      Kp * error;

    if (i == 0) {

      digitalWrite(
        dirPin[i],
        (Voltage > 0) ? HIGH : LOW
      );

    } else {

      digitalWrite(
        dirPin[i],
        (Voltage > 0) ? LOW : HIGH
      );
    }

    unsigned int PWM =
      255 * fabs(Voltage) / Battery_Voltage;

    analogWrite(
      pwmPin[i],
      min(PWM, 255)
    );
  }

  // =================================================
  // CHECK MOVEMENT COMPLETION
  // =================================================

  if (
    mode == SEARCH_TURN ||
    mode == ALIGN_TURN ||
    mode == DRIVE ||
    mode == ARROW_TURN
  ) {

    bool inBand =
      fabs(pos_error_now[0]) < POS_DEADBAND_RAD &&
      fabs(pos_error_now[1]) < POS_DEADBAND_RAD;

    settle_count =
      inBand ? settle_count + 1 : 0;

    bool finished =
      (settle_count >= SETTLE_SAMPLES) ||
      (millis() - move_start_ms > MOVE_TIMEOUT_MS);

    if (finished) {

      // ---- Search turn finished ----

      if (mode == SEARCH_TURN) {

        pause_start_ms = millis();
        mode = SEARCH_WAIT;

      // ---- Alignment finished ----

      } else if (mode == ALIGN_TURN) {

        float drive_in =
          cmd_distance_in - STOP_DISTANCE_IN;

        if (drive_in < 0) {
          drive_in = 0;
        }

        float r =
          drive_in / WHEEL_RADIUS_IN;

        startMove(
          -r,
          -r,
          counts[0],
          counts[1],
          DRIVE
        );

      // ---- Drive finished: arrow turn ----

      } else if (
        mode == DRIVE &&
        ENABLE_ARROW_TURN
      ) {

        float w =
          turnDegToWheelRad(90.0);

        float dir =
          (cmd_arrow == 'L') ? 1.0 : -1.0;

        startMove(
          -TURN_SIGN * dir * w,
           TURN_SIGN * dir * w,
          counts[0],
          counts[1],
          ARROW_TURN
        );

      // ---- Everything finished ----

      } else {

        mode = DONE;
      }
    }
  }
}
