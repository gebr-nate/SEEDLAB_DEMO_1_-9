#demo2 - jake toschikk locate aruco beacon, determine angle and distance
#approach beacon, and determine arrow direction


import math
import cv2
from cv2 import aruco
from time import sleep#for cam stuff
import threading
import queue
import board
import busio#lcd libraries
import adafruit_character_lcd.character_lcd_rgb_i2c as character_lcd
import serial

#for turning
ENABLE_ARROW_TURN=False


#serial setup
arduino = serial.Serial(
    '/dev/ttyACM0',
    115200,
    timeout=1
    )
sleep(2)

lcd_queue = queue.Queue(maxsize=1)#lcd message queue for threading, max size 1 so it doesnt flood queue

lcd_columns = 16
lcd_rows = 2#lcd size

i2c = board.I2C()#i2c connection

lcd = character_lcd.Character_LCD_RGB_I2C(
    i2c,
    lcd_columns,
    lcd_rows
)#tells adafruit lib to create lcd that uses i2c and is 16x2

aruco_dict=aruco.getPredefinedDictionary(aruco.DICT_6X6_50) #aruco dic
parameters=aruco.DetectorParameters() #detector parameters
parameters.minMarkerPerimeterRate = 0.01#controls min marker consideration

def update_lcd():
    while True:#doesnt end on its own
            message = lcd_queue.get()#get queue message
            lcd.message = message#display message
#lcd thread start
lcd_thread = threading.Thread(target=update_lcd)#new thread whose job is to run the updatelcd func
lcd_thread.daemon = True #keep program alive
lcd_thread.start()


#camera set
camera=cv2.VideoCapture(0)#open cam
camera.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
camera.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)#image is 640x480 pixels
camera.set(cv2.CAP_PROP_FPS, 30)
camera.set(cv2.CAP_PROP_BUFFERSIZE, 1)

sleep(0.5) #camera time to start
last_message=""#used later so dont need to keep clearing and rewriting lcd
command_sent=False
stable_count=0
previous_distance=None
previous_angle=None




def detect_arrow(frame, marker_corners):

    hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)

    # Green arrow
    green_lower = (35, 80, 60)
    green_upper = (85, 255, 255)

    green_mask = cv2.inRange(
        hsv, green_lower, green_upper
    )

    # Red arrow (red wraps around HSV hue)
    red_mask1 = cv2.inRange(
        hsv, (0, 100, 70), (10, 255, 255)
    )

    red_mask2 = cv2.inRange(
        hsv, (170, 100, 70), (179, 255, 255)
    )

    red_mask = cv2.bitwise_or(
        red_mask1, red_mask2
    )

    # Search near marker, not entire frame
    x_min = int(marker_corners[:, 0].min())
    x_max = int(marker_corners[:, 0].max())
    y_min = int(marker_corners[:, 1].min())
    y_max = int(marker_corners[:, 1].max())

    marker_width = x_max - x_min
    marker_height = y_max - y_min

    height, width = frame.shape[:2]

    x1 = max(0, x_min - 2 * marker_width)
    x2 = min(width, x_max + 2 * marker_width)
    y1 = max(0, y_min - marker_height // 2)
    y2 = min(height, y_max + marker_height // 2)

    green_roi = green_mask[y1:y2, x1:x2]
    red_roi = red_mask[y1:y2, x1:x2]

    green_pixels = cv2.countNonZero(green_roi)
    red_pixels = cv2.countNonZero(red_roi)

    # Require enough colored pixels to avoid noise
    min_pixels = max(20, int(marker_width * marker_height * 0.03))

    if green_pixels > min_pixels and green_pixels > red_pixels * 2:
        return 'L'

    if red_pixels > min_pixels and red_pixels > green_pixels * 2:
        return 'R'

    return None




#cam loop for aruco detect+greyscale
while True:
    ret,frame=camera.read()#take pic
    if not ret:
        print("Didn't read camera")#if didnt take pic
        continue
    #convert to greyscale
    grey=cv2.cvtColor(frame,cv2.COLOR_BGR2GRAY)

    #detect aruco markers using grey,aruco dict, and parameter
    corners,ids,rejected=aruco.detectMarkers(
        grey,
        aruco_dict,
        parameters=parameters
        )

    #make copy so can draw boxes on markers
    overlay = frame.copy()
    #quadrant lines on cam
    cv2.line(overlay, (320, 0), (320, 480), (0,255,0), 2)
    
    #see if markers found, verify if its marker 0 for demo1
    if ids is not None:
        ids=ids.flatten()#changes to one dim arrayy
        aruco.drawDetectedMarkers(overlay,corners,ids)#draws outline around markers in overlay
    #look for marker 0
        if 0 in ids:
            marker_index=list(ids).index(0)
            marker_corners = corners[marker_index][0]
            #marker width
            top_left=marker_corners[0]
            top_right=marker_corners[1]

            marker_width_pixels=math.sqrt((top_right[0]-top_left[0])**2+(top_right[1]-top_left[1])**2)

            #distance cal
            distance_constant = 1251.5
            #calc distance to marker
            distance_inches = distance_constant/marker_width_pixels
            distance_feet = distance_inches/12
            print("marker width:", marker_width_pixels)
            print("distance {:.2f} inches".format(distance_inches))
            print("distance: {:.2f} feet".format(distance_feet))
        
    
        #calc center of marker 0
            center_x=int(marker_corners[:,0].mean())
            center_y=int(marker_corners[:,1].mean())
        #center point on image
            cv2.circle(overlay, (center_x, center_y), 5, (0, 0, 255), -1)
        #cam image center
            camera_center_x=320
        #horiz pixel diff from camera center
            pixel_offset=camera_center_x-center_x

        #focal length found from camera cal
            fx=652.5
            angle_rad=math.atan(pixel_offset/fx)#horizontal angle calc
            angle_deg=math.degrees(angle_rad)

        

            if ENABLE_ARROW_TURN:
                arrow_direction = detect_arrow(
                frame,
                marker_corners
                )

                print("Arrow direction:", arrow_direction)


            
            print("marker center:", center_x)
            print("pixel offset:", pixel_offset)
            print("X Angle: {:.2f} degrees".format(angle_deg))


        


    if not command_sent:

        if ENABLE_ARROW_TURN:
        # Part 2: arrow detection will be added here
            arrow_direction = None

            if arrow_direction in ('L', 'R'):
                command = "{:.2f},{:.2f},{}\n".format(
                    distance_inches,
                    angle_deg,
                    arrow_direction
                )
            else:
                command = None
        else:
        # Part 1: send distance and angle
            command = "{:.2f},{:.2f}\n".format(
                distance_inches,
                angle_deg
            )
        if command is not None and 30 <= distance_inches <= 100:
            if previous_distance is not None and previous_angle is not None:
                if (abs(distance_inches - previous_distance) <= 4.0 and
                        abs(angle_deg - previous_angle) <= 4.0):
                    stable_count += 1
                else:
                    stable_count = 1
            else:
                stable_count = 1

            previous_distance = distance_inches
            previous_angle = angle_deg

            if stable_count >= 5:
                arduino.write(command.encode("ascii"))
                arduino.flush()

                print("Sent to Arduino:", command.strip())

                command_sent = True
        

    
      # update LCD only when marker 0 is detected
    if ids is not None and 0 in ids:
        message = "Marker Detected\nX Angle: {:.2f}".format(angle_deg)
    else:
        message = "Searching..."
        if not command_sent:
            stable_count = 0
            previous_distance = None
            previous_angle = None

    # only update LCD if message changed
    if message != last_message:
        if lcd_queue.empty():
            lcd_queue.put(message)
        last_message = message

    # display camera
    cv2.imshow("aruco detection", overlay)

    # check if q key is pressed
    k = cv2.waitKey(1) & 0xFF
    if k == ord('q'):
        break

# runs after q breaks out of while loop
camera.release()
arduino.close()
cv2.destroyAllWindows()
